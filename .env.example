# =============================================================================
# Audient — Environment Variables
# Copy to `.env.local` and fill in real values. NEVER commit real secrets.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser bundle.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Supabase (Auth + Database + Storage)
# Project Settings → API.
#
# URL must be the project ORIGIN only (no /rest/v1 path):
#   https://your-project-ref.supabase.co
#
# Mock frontend (`USE_MOCK_AUTH=true` in src/config/auth.ts) works without a
# live Supabase session. Public URL + anon key are still used for connection
# verification (`npm run verify:supabase`, GET /api/health).
#
# SUPABASE_SERVICE_ROLE_KEY is SERVER-ONLY — never expose it to the browser
# and never prefix it with NEXT_PUBLIC_.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Required for BACKEND-005 credit deduct/refund (server-only; never NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Auth providers (configure in Supabase Dashboard → Authentication → Providers):
# - Google OAuth (BACKEND-003 primary — Client ID + secret)
# - Apple / Azure — later; mock SSO remains available while USE_MOCK_AUTH=true
# Redirect allow-list must include:
#   {NEXT_PUBLIC_APP_URL}/auth/callback
#
# Controlled real Google OAuth while mock stays default (BACKEND-003):
# NEXT_PUBLIC_REAL_OAUTH_DEV_PATH="true"

# -----------------------------------------------------------------------------
# Database (optional direct Postgres access for tooling / workers)
# Prefer Supabase clients for app queries. Use the pooler URL when connecting
# from serverless; use the direct URL for migrations via Supabase CLI.
# -----------------------------------------------------------------------------
# DATABASE_URL="postgresql://postgres:[password]@[host]:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:[password]@[host]:5432/postgres"

# -----------------------------------------------------------------------------
# Stripe (Billing) — BACKEND-007 TEST MODE ONLY
# SERVER-ONLY secrets: never NEXT_PUBLIC_STRIPE_SECRET_KEY / WEBHOOK_SECRET.
# Live keys (sk_live_) are rejected by the app.
# -----------------------------------------------------------------------------
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# Production live billing only (never for local test):
# ALLOW_STRIPE_LIVE="true"   # requires NODE_ENV=production + sk_live_ key
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Create matching TEST Prices in Stripe Dashboard (amounts = PRICING.md), then:
# STRIPE_PRICE_PRO_MONTHLY="price_..."          # $29/mo recurring → PRO / 1000 credits
# STRIPE_PRICE_BUSINESS_MONTHLY="price_..."     # $99/mo recurring → ENTERPRISE / 10000
# STRIPE_PRICE_PACK_500="price_..."             # $9 one-time → 500 credits
# STRIPE_PRICE_PACK_2000="price_..."            # $29 one-time → 2000 credits
# STRIPE_PRICE_PACK_5000="price_..."            # $59 one-time → 5000 credits
# Local webhook: stripe listen --forward-to localhost:3000/api/webhooks/stripe

# -----------------------------------------------------------------------------
# Background jobs / cache (BullMQ + Redis) — later sprints
# -----------------------------------------------------------------------------
# REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# AI provider (OpenAI) — BACKEND-006 audit engine
# SERVER-ONLY. Never use NEXT_PUBLIC_OPENAI_API_KEY.
# Real AI runs only for real Supabase sessions (mock-* auth stays on mock path).
# -----------------------------------------------------------------------------
OPENAI_API_KEY="sk-..."
# Optional model override (default gpt-4o-mini)
# OPENAI_AUDIT_MODEL="gpt-4o-mini"
# Alias accepted by server code:
# AI_API_KEY="sk-..."

# -----------------------------------------------------------------------------
# Production launch (BACKEND-012) — set on hosting platform only
# NODE_ENV=production (usually set by host)
# USE_MOCK_AUTH is automatically false when NODE_ENV=production
# ALLOW_STRIPE_LIVE="true"   # required for sk_live_ keys
# Live Stripe + live Price IDs — see docs/backend/BACKEND-012_PRODUCTION_READINESS.md
# Pre-deploy gate: GET /api/health → ready=true, mockAuth=false, configIssues=[]
# Post-deploy gate: DEPLOY_HEALTH_URL=https://... npm run verify:health-gate
# Boot fail-closed: src/instrumentation.ts (production only)
# Full checklist: docs/backend/BACKEND-012A_PRODUCTION_BLOCKER_CLOSURE.md
# -----------------------------------------------------------------------------
