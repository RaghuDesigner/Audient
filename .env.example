# =============================================================================
# Audient — Environment Variables
# Copy to `.env.local` and fill in real values. NEVER commit real secrets.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser bundle.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Supabase (Auth + Database + Storage) — required
# Project settings → API. The service-role key is SERVER-ONLY; never expose it.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# -----------------------------------------------------------------------------
# Database (optional direct Postgres access for tooling / workers)
# Prefer Supabase clients for app queries. Use the pooler URL when connecting
# from serverless; use the direct URL for migrations via Supabase CLI.
# -----------------------------------------------------------------------------
# DATABASE_URL="postgresql://postgres:[password]@[host]:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:[password]@[host]:5432/postgres"

# -----------------------------------------------------------------------------
# Stripe (Billing) — later sprints
# -----------------------------------------------------------------------------
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# -----------------------------------------------------------------------------
# Background jobs / cache (BullMQ + Redis) — later sprints
# -----------------------------------------------------------------------------
# REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# AI provider (multimodal LLM behind lib/ai) — later sprints
# -----------------------------------------------------------------------------
# AI_API_KEY="your-llm-provider-key"
